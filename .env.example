# Copia este fichero a `.env` y ajusta lo que necesites.
# `.env` está en .gitignore: NUNCA subas claves al repositorio.
# Todas las variables llevan el prefijo SCRAPER_.

# ---------------------------------------------------------------- identidad
# User-Agent identificable. Pon un contacto real: es lo correcto y evita bloqueos.
SCRAPER_USER_AGENT=scraper-galileo/0.1 (+https://github.com/juanjararPYBM/-galileo; contacto: tu-email@ejemplo.com)

# ------------------------------------------------------- buenas prácticas
# Respetar robots.txt. Déjalo en true salvo que el sitio sea tuyo o tengas permiso.
SCRAPER_RESPECT_ROBOTS=true
# Segundos mínimos entre peticiones al mismo dominio.
SCRAPER_RATE_LIMIT_SECONDS=2.0
# Reintentos y backoff exponencial (espera = backoff_factor * 2**intento).
SCRAPER_MAX_RETRIES=3
SCRAPER_BACKOFF_FACTOR=1.0
SCRAPER_REQUEST_TIMEOUT=30.0

# ----------------------------------------------------- selectores adaptativos
SCRAPER_ADAPTIVE=true
# Similitud mínima (%) para dar por buena una reubicación.
SCRAPER_ADAPTIVE_PERCENTAGE=40
# Umbral (0-1) al agrupar los elementos hermanos de una misma columna.
SCRAPER_ADAPTIVE_SIMILARITY=0.5
# Carpeta donde se guarda la huella de los elementos (elements_storage.db).
SCRAPER_STATE_DIR=.scraper_state

# ------------------------------------------------------------- navegador
# Solo si los modos `dynamic`/`stealth` no encuentran el navegador de Playwright.
# SCRAPER_BROWSER_EXECUTABLE_PATH=/ruta/a/chrome

# ------------------------------------------------------------------- LLM
# Proveedor: ollama (local, por defecto) | openai | custom (endpoint compatible OpenAI)
SCRAPER_LLM_PROVIDER=ollama
# Modelos ligeros que van bien en CPU: llama3.2:3b (recomendado), qwen2.5:3b, gemma2:2b
SCRAPER_LLM_MODEL=llama3.2:3b
SCRAPER_LLM_BASE_URL=http://localhost:11434
SCRAPER_LLM_TEMPERATURE=0.0
SCRAPER_LLM_MODEL_TOKENS=8192
SCRAPER_LLM_TIMEOUT=180.0
# Descargar el HTML con Scrapling y pasárselo al motor LLM (misma cortesía en ambos
# motores y sin necesidad de navegador). Ponlo en false para que descargue él.
SCRAPER_LLM_PREFETCH=true

# Clave del proveedor alternativo. Déjala VACÍA aquí y ponla solo en tu `.env` local.
# SCRAPER_LLM_API_KEY=
